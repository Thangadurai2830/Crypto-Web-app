# Application
APP_NAME=Crypto Market Analytics API
DEBUG=false

# Database (use SQLite for local dev; PostgreSQL for Docker/production)
DATABASE_URL=sqlite+aiosqlite:///./crypto_analytics.db
# DATABASE_URL=postgresql+asyncpg://crypto_user:crypto_pass@localhost:5432/crypto_db

# Data source: coingecko | binance | both
DATA_SOURCE=coingecko
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
BINANCE_BASE_URL=https://api.binance.com

# Ingestion
TOP_N_ASSETS=10
FETCH_INTERVAL_MINUTES=5
# Scheduled jobs
ANALYTICS_INTERVAL_MINUTES=15
STRATEGY_INTERVAL_MINUTES=60
CLEANUP_INTERVAL_HOURS=24
MARKET_DATA_RETENTION_DAYS=30
ANALYTICS_RESULTS_RETENTION_DAYS=7
STRATEGY_RUNS_RETENTION_DAYS=30
# CoinGecko client (retry + rate limit)
COINGECKO_REQUEST_TIMEOUT_SEC=30
COINGECKO_MAX_RETRIES=3
COINGECKO_RETRY_BACKOFF_SEC=2
COINGECKO_RATE_LIMIT_CALLS_PER_MINUTE=10

# Analytics
DEFAULT_PRICE_WINDOW_HOURS=24
DEFAULT_VOLUME_WINDOW_HOURS=24

# Strategy (MA crossover: fast/slow; RSI: period/levels; volume confirmation)
MA_FAST_PERIOD=7
MA_SLOW_PERIOD=21
MA_SHORT_PERIOD=10
MA_LONG_PERIOD=30
MOMENTUM_THRESHOLD_PCT=5.0
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
VOLUME_CONFIRMATION_RATIO=1.0

# CORS (comma-separated or leave default)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_EXPOSE_HEADERS=X-Request-ID,X-Response-Time-Ms,X-RateLimit-Limit,X-RateLimit-Remaining
# CORS_MAX_AGE=600

# Rate limiting (per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60

# API key (optional; set to require X-API-Key for all /v1 routes; both keys accepted for rotation)
# API_KEY_ENABLED=false
# API_KEY_CURRENT=
# API_KEY_PREVIOUS=
