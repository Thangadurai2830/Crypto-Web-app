    "date-fns": "^3.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.28.0",
    "framer-motion": "^11.11.0",
    "html-to-image": "^1.11.11",
    "recharts": "^2.13.0",
    "@tanstack/react-virtual": "^3.12.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/jest-dom": "^6.6.3",
