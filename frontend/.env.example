# Backend API base URL.
# - Dev (Vite proxy): use /api so requests go to same origin and are proxied to backend (see vite.config.ts).
# - Production: set to full backend URL, e.g. https://api.example.com (no /v1 suffix; client adds it).
VITE_API_URL=/api

# Optional: when backend has API_KEY_ENABLED=true, set the key so the frontend sends X-API-Key on every request.
# VITE_API_KEY=your-secret-key
